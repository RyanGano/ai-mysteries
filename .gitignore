# dependencies
node_modules/

# build output
dist/

# .NET build output
bin/
obj/
.vs/

# local-only source materials (never commit)
source_materials/

# Book content lives in Cosmos DB, not in the repo. The files under Content/ are the local
# authoring copy (source of truth for the gen-xrefs pipeline) and are seeded into Cosmos via
# the ai-mysteries-tools `seed` command. Never commit book data.
ai-mysteries-api/Content/

# internal planning/reference docs (never commit)
plans/
docs/

# Local-only cache of cover art for offline dev testing. The covers are served in prod from
# their absolute blob URLs (meta.json coverImage); these downloaded copies are never committed.
ai-mysteries-web/public/covers/

# Vite / TypeScript build cache
*.local
node_modules/.tmp/

# editor
.vscode/
.idea/
*.swp

# env files
.env
.env.*
!.env.example
