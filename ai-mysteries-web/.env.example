# Base URL of the book API. Defaults to http://localhost:5180 when unset (see src/lib/api.ts).
# Copy to .env.local and adjust if the API runs elsewhere.
VITE_API_BASE_URL=http://localhost:5180

# To run the local UI against the PROD API: the prod API's CORS only trusts the deployed
# front end, so direct browser calls from localhost are blocked. Instead let the Vite dev
# server proxy /api to prod (same-origin in the browser, so CORS never applies):
#   VITE_API_BASE_URL=
#   VITE_PROXY_TARGET=https://<prod-api-host>
